{
  "$schema": "https://design-tokens.org/schema/tokens.json",
  "$metadata": {
    "tokenSetOrder": ["color", "typography", "spacing", "radius", "shadow", "icon"]
  },
  "color": {
    "bg": {
      "base":      { "$value": "#0D0D0D", "$type": "color", "$description": "App window background" },
      "surface-1": { "$value": "#161616", "$type": "color", "$description": "Sidebar, status bar background" },
      "surface-2": { "$value": "#1E1E1E", "$type": "color", "$description": "Card / panel background" },
      "surface-3": { "$value": "#252525", "$type": "color", "$description": "Nested card, code block background" },
      "elevated":  { "$value": "#2D2D2D", "$type": "color", "$description": "Popover, dropdown, tooltip background" }
    },
    "border": {
      "subtle":  { "$value": "#2A2A2A", "$type": "color", "$description": "Low-contrast dividers" },
      "default": { "$value": "#363636", "$type": "color", "$description": "Standard borders" },
      "strong":  { "$value": "#484848", "$type": "color", "$description": "Active / focused state border" }
    },
    "text": {
      "primary":   { "$value": "#F5F5F5", "$type": "color", "$description": "Main body text" },
      "secondary": { "$value": "#A3A3A3", "$type": "color", "$description": "Labels, descriptions" },
      "muted":     { "$value": "#737373", "$type": "color", "$description": "Disabled, placeholder" },
      "code":      { "$value": "#E5E5E5", "$type": "color", "$description": "Monospace code text" }
    },
    "accent": {
      "400": { "$value": "#A78BFA", "$type": "color", "$description": "Hover states — Sovereign Violet light" },
      "500": { "$value": "#8B5CF6", "$type": "color", "$description": "Primary buttons, active nav, links" },
      "600": { "$value": "#7C3AED", "$type": "color", "$description": "Button active / pressed" }
    },
    "semantic": {
      "green-400":  { "$value": "#4ADE80", "$type": "color", "$description": "Online, accepted, success" },
      "green-500":  { "$value": "#22C55E", "$type": "color", "$description": "Running, healthy" },
      "red-400":    { "$value": "#F87171", "$type": "color", "$description": "Error state" },
      "red-500":    { "$value": "#EF4444", "$type": "color", "$description": "Critical error, offline" },
      "yellow-400": { "$value": "#FACC15", "$type": "color", "$description": "Warning, training active" },
      "yellow-500": { "$value": "#EAB308", "$type": "color", "$description": "Caution" },
      "blue-400":   { "$value": "#60A5FA", "$type": "color", "$description": "Info, streaming tokens" },
      "blue-500":   { "$value": "#3B82F6", "$type": "color", "$description": "Download progress" }
    },
    "special": {
      "local-badge-bg": { "$value": "#1A2744", "$type": "color", "$description": "Running Locally badge background" },
      "local-badge-fg": { "$value": "#60A5FA", "$type": "color", "$description": "Running Locally badge text" }
    }
  },
  "typography": {
    "fontFamily": {
      "ui":   { "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "$type": "fontFamily" },
      "code": { "$value": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace",    "$type": "fontFamily" }
    },
    "fontSize": {
      "xs":   { "$value": "11px", "$type": "dimension" },
      "sm":   { "$value": "13px", "$type": "dimension" },
      "base": { "$value": "14px", "$type": "dimension" },
      "md":   { "$value": "15px", "$type": "dimension" },
      "lg":   { "$value": "17px", "$type": "dimension" },
      "xl":   { "$value": "20px", "$type": "dimension" },
      "2xl":  { "$value": "24px", "$type": "dimension" },
      "3xl":  { "$value": "32px", "$type": "dimension" }
    },
    "fontWeight": {
      "regular":   { "$value": "400", "$type": "fontWeight" },
      "medium":    { "$value": "500", "$type": "fontWeight" },
      "semibold":  { "$value": "600", "$type": "fontWeight" },
      "bold":      { "$value": "700", "$type": "fontWeight" }
    },
    "lineHeight": {
      "xs":   { "$value": "16px", "$type": "dimension" },
      "sm":   { "$value": "18px", "$type": "dimension" },
      "base": { "$value": "20px", "$type": "dimension" },
      "md":   { "$value": "22px", "$type": "dimension" },
      "lg":   { "$value": "24px", "$type": "dimension" },
      "xl":   { "$value": "28px", "$type": "dimension" },
      "2xl":  { "$value": "32px", "$type": "dimension" },
      "3xl":  { "$value": "40px", "$type": "dimension" }
    }
  },
  "spacing": {
    "xs":  { "$value": "4px",  "$type": "dimension", "$description": "Icon padding, tight spacing" },
    "sm":  { "$value": "8px",  "$type": "dimension", "$description": "Component internal padding" },
    "md":  { "$value": "12px", "$type": "dimension", "$description": "Standard gap" },
    "lg":  { "$value": "16px", "$type": "dimension", "$description": "Section gap" },
    "xl":  { "$value": "24px", "$type": "dimension", "$description": "Panel padding" },
    "2xl": { "$value": "32px", "$type": "dimension", "$description": "Section separation" },
    "3xl": { "$value": "48px", "$type": "dimension", "$description": "Screen-level spacing" }
  },
  "borderRadius": {
    "none": { "$value": "0px",    "$type": "dimension", "$description": "Progress bars, status bars" },
    "sm":   { "$value": "4px",    "$type": "dimension", "$description": "Badges, chips, small buttons" },
    "md":   { "$value": "6px",    "$type": "dimension", "$description": "Buttons, inputs, small cards" },
    "lg":   { "$value": "8px",    "$type": "dimension", "$description": "Cards, panels" },
    "xl":   { "$value": "12px",   "$type": "dimension", "$description": "Modals, large cards" },
    "full": { "$value": "9999px", "$type": "dimension", "$description": "Toggle pills, avatar circles" }
  },
  "shadow": {
    "card": {
      "$value": {
        "color": "#00000040",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "4px",
        "spread": "0px"
      },
      "$type": "shadow",
      "$description": "Cards, panels"
    },
    "elevated": {
      "$value": {
        "color": "#00000066",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "0px"
      },
      "$type": "shadow",
      "$description": "Popovers, modals"
    },
    "focus": {
      "$value": {
        "color": "#8B5CF6",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "2px"
      },
      "$type": "shadow",
      "$description": "Focus ring — accent-500"
    }
  },
  "icon": {
    "size": {
      "status-bar":   { "$value": "14px", "$type": "dimension", "$description": "Icons in status bar" },
      "sidebar-nav":  { "$value": "18px", "$type": "dimension", "$description": "Sidebar navigation icons" },
      "button":       { "$value": "16px", "$type": "dimension", "$description": "Button inline icons" },
      "screen-title": { "$value": "20px", "$type": "dimension", "$description": "Screen title icons" },
      "empty-state":  { "$value": "48px", "$type": "dimension", "$description": "Empty state illustration icons" }
    }
  },
  "component": {
    "sidebar": {
      "width-expanded":  { "$value": "220px", "$type": "dimension" },
      "width-collapsed": { "$value": "56px",  "$type": "dimension" },
      "nav-item-height": { "$value": "40px",  "$type": "dimension" }
    },
    "statusBar": {
      "height": { "$value": "28px", "$type": "dimension" }
    },
    "titleBar": {
      "height": { "$value": "32px", "$type": "dimension" }
    },
    "commandPalette": {
      "width":      { "$value": "640px", "$type": "dimension" },
      "max-height": { "$value": "480px", "$type": "dimension" }
    }
  }
}
