{
  "name": "sovereign-coder",
  "displayName": "Sovereign Coder",
  "description": "Local AI code completions powered by Ollama",
  "version": "0.1.0",
  "publisher": "sovereign-ai-labs",
  "engines": {
    "vscode": "^1.68.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sovereign-coder.toggleCompletions",
        "title": "Sovereign Coder: Toggle Inline Completions"
      }
    ],
    "configuration": {
      "title": "Sovereign Coder",
      "properties": {
        "sovereign-coder.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline code completions"
        },
        "sovereign-coder.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server base URL"
        },
        "sovereign-coder.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Ollama model to use for completions"
        },
        "sovereign-coder.maxTokens": {
          "type": "number",
          "default": 128,
          "description": "Maximum tokens to generate per completion"
        },
        "sovereign-coder.triggerOnTyping": {
          "type": "boolean",
          "default": true,
          "description": "Trigger completions automatically while typing"
        },
        "sovereign-coder.ragEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable RAG project context in completions (requires nomic-embed-text in Ollama)"
        },
        "sovereign-coder.embeddingModel": {
          "type": "string",
          "default": "nomic-embed-text",
          "description": "Ollama model to use for generating embeddings"
        },
        "sovereign-coder.ragTopK": {
          "type": "number",
          "default": 3,
          "description": "Number of context chunks to retrieve per completion"
        },
        "sovereign-coder.ragMaxContextChars": {
          "type": "number",
          "default": 2000,
          "description": "Maximum characters of retrieved context to prepend to the prompt"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.68.0",
    "@vitest/coverage-v8": "^1.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0"
  }
}
