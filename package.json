{
  "name": "sovereign-code-workspace",
  "version": "1.0.0",
  "description": "Sovereign Code monorepo for desktop app, VS Code extension, and local services.",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "apps/vscode-extension"
  ],
  "scripts": {
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:test": "npm --prefix apps/desktop run test",
    "extension:test": "npm --prefix apps/vscode-extension run test",
    "sovereign:week1:check": "node scripts/sovereign-week1-runtime-check.mjs",
    "sovereign:week1:benchmark": "node scripts/sovereign-week1-benchmark.mjs",
    "sovereign:week1:evidence": "node scripts/sovereign-week1-evidence-bundle.mjs",
    "sovereign:week1:report": "node scripts/sovereign-week1-report.mjs",
    "sovereign:week1:checkpoint": "node scripts/sovereign-week1-checkpoint.mjs",
    "sovereign:week1:run": "node scripts/sovereign-week1-daily-run.mjs",
    "sovereign:week1:ci": "node scripts/sovereign-week1-ci-run.mjs",
    "sovereign:week1:trend": "node scripts/sovereign-week1-trend.mjs",
    "sovereign:week1:status-pack": "node scripts/sovereign-week1-status-pack.mjs",
    "test:sovereign": "node --test scripts/tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
