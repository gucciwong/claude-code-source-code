{
  "name": "@anthropic-ai/claude-code-source",
  "version": "2.1.88",
  "description": "Claude Code v2.1.88 — decompiled source for research",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare-src": "node scripts/prepare-src.mjs",
    "build": "npm run prepare-src && node scripts/build.mjs",
    "check": "npm run prepare-src && tsc --noEmit",
    "start": "node dist/cli.js",
    "sovereign:week1:check": "node scripts/sovereign-week1-runtime-check.mjs",
    "sovereign:week1:benchmark": "node scripts/sovereign-week1-benchmark.mjs",
    "sovereign:week1:evidence": "node scripts/sovereign-week1-evidence-bundle.mjs",
    "sovereign:week1:run": "node scripts/sovereign-week1-daily-run.mjs",
    "test:sovereign": "node --test scripts/tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "typescript": "^6.0.2"
  }
}
