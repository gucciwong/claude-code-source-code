# Training Service Configuration

# Service
PORT=8001
LOG_LEVEL=INFO

# Database
DB_PATH=./data/training.db

# Model defaults
DEFAULT_BASE_MODEL=mistral-7b
DEFAULT_DEVICE=auto  # auto, cpu, cuda, mps

# Training config
QUICK_TRAIN_INTERVAL_MINUTES=10
FULL_TRAIN_THRESHOLD_ITERATIONS=48

# Benchmarking
HUMANEVAL_NUM_PROBLEMS=30  # Full benchmark: 164, quick: 30
MBPP_NUM_PROBLEMS=50  # Full benchmark: 500, quick: 50

# Data management
MAX_EVENTS_RETENTION_DAYS=90
CLEANUP_SCHEDULE_HOURS=24
