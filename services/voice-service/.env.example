# Voice Service Configuration
PORT=8000
LOG_LEVEL=INFO

# Device Configuration (GPU/CPU Auto-Detection)
DEVICE=auto  # auto (detect), cuda, mps, cpu
WHISPER_MODEL_SIZE=base  # tiny, base, small, medium, large
WHISPER_COMPUTE_TYPE=default  # default, float16, int8
WHISPER_DEVICE=auto  # auto, cuda, mps, cpu (overrides DEVICE for ASR)

# TTS Configuration
TTS_DEFAULT_LANG=en
TTS_OUTPUT_DIR=/tmp/voice-service

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# GPU Optimization
ENABLE_GPU_OPTIMIZATION=true  # Use float16/quantization for faster inference
GPU_MEMORY_FRACTION=0.8  # Fraction of GPU memory to use (0.0-1.0)

# Streaming / WebSocket Configuration
VAD_AGGRESSIVENESS=2  # Voice Activity Detection aggressiveness (0-3, higher=more aggressive)
SILENCE_THRESHOLD_MS=800  # Duration of silence (ms) before finalizing utterance
MIN_UTTERANCE_DURATION_MS=500  # Minimum utterance duration (ms) to transcribe
STREAMING_BUFFER_DURATION_MS=4000  # Max buffered audio duration (ms)
STREAMING_CHUNK_DURATION_MS=320  # Audio chunk duration (ms)

# Model Quantization & Optimization
USE_ONNX_MODELS=false  # Use ONNX Runtime for inference (requires quantized models)
MODEL_QUANTIZATION_TYPE=int8  # Quantization type: fp32, fp16, int8, int4
MODEL_CACHE_DIR=/tmp/vibevoice-models  # Cache directory for downloaded models
LOAD_QUANTIZED_MODELS=true  # Auto-load quantized versions when available
ENABLE_MODEL_OPTIMIZATION=true  # Enable various inference optimizations
